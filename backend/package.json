{
  "name": "pdcl-ict-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node deploy.mjs",
    "deploy:dry-run": "node deploy.mjs --dry-run",
    "deploy:verify": "node deploy.mjs --verify",
    "deploy:backup": "node deploy.mjs --backup-only",
    "migrate": "node deploy.mjs --force",
    "migrate:list": "node deploy.mjs --list",
    "migrate:rollback": "node deploy.mjs --rollback"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0"
  }
}